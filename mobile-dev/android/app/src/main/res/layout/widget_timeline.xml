<?xml version="1.0" encoding="utf-8"?>
<!--
  RemoteViews-safe layout. Uses only LinearLayout (no RelativeLayout with layout_below).
  No plain <View> tags. No paddingHorizontal/paddingVertical shorthand.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/timeline_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Timeline"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/today_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TODAY"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/today_badge_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <!-- Task 1 -->
    <LinearLayout android:id="@+id/task_row_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp" android:visibility="gone">
        <ImageView android:id="@+id/task_circle_1" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/task_circle_empty" android:layout_marginEnd="14dp" android:contentDescription="status" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/task_title_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#F9FAFB" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/task_time_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#6B7280" android:textSize="11sp" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Task 2 -->
    <LinearLayout android:id="@+id/task_row_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp" android:visibility="gone">
        <ImageView android:id="@+id/task_circle_2" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/task_circle_empty" android:layout_marginEnd="14dp" android:contentDescription="status" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/task_title_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#F9FAFB" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/task_time_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#6B7280" android:textSize="11sp" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Task 3 -->
    <LinearLayout android:id="@+id/task_row_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp" android:visibility="gone">
        <ImageView android:id="@+id/task_circle_3" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/task_circle_empty" android:layout_marginEnd="14dp" android:contentDescription="status" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/task_title_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#F9FAFB" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/task_time_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#6B7280" android:textSize="11sp" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Task 4 -->
    <LinearLayout android:id="@+id/task_row_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp" android:visibility="gone">
        <ImageView android:id="@+id/task_circle_4" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/task_circle_empty" android:layout_marginEnd="14dp" android:contentDescription="status" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/task_title_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#F9FAFB" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/task_time_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#6B7280" android:textSize="11sp" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Task 5 -->
    <LinearLayout android:id="@+id/task_row_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp" android:visibility="gone">
        <ImageView android:id="@+id/task_circle_5" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/task_circle_empty" android:layout_marginEnd="14dp" android:contentDescription="status" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/task_title_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#F9FAFB" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/task_time_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#6B7280" android:textSize="11sp" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/more_tasks_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#6B7280" android:textSize="11sp" android:visibility="gone" />
    <TextView android:id="@+id/empty_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No tasks scheduled" android:textColor="#6B7280" android:textSize="14sp" android:gravity="center" android:layout_marginTop="16dp" android:visibility="gone" />

</LinearLayout>
