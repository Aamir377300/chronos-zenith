{
  "expo": {
    "name": "Chronos Zenith",
    "slug": "chronos-zenith",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chronoszenith.app",
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3B82F6"
      },
      "package": "com.chronoszenith.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client"
    ],
    "scheme": "chronos-zenith",
    "extra": {
      "eas": {
        "projectId": "04a94f31-4fd6-44a4-9966-06bd5ae6b5fc"
      },
      "router": {}
    },
    "owner": "belalaamirkhan"
  }
}
